#!/usr/bin/env bash
# The one entry point. Every acceptance criterion in .ship/specs/ names a target here.
set -euo pipefail
cd "$(dirname "$0")"

MVN="./mvnw -q -Dstyle.color=never"

# Goal 5's first half is a claim about tracked files, so it is checked here rather than
# in a Java test that could only ever inspect the running process.
check_secrets() {
  local failed=0

  if git ls-files --error-unmatch secrets.properties >/dev/null 2>&1; then
    echo "FAIL: secrets.properties is tracked by git" >&2
    failed=1
  fi

  if ! git check-ignore -q secrets.properties; then
    echo "FAIL: secrets.properties is not git ignored" >&2
    failed=1
  fi

  local hits
  hits=$(git ls-files -z | xargs -0 grep -lE '(sk|rk)_(test|live)_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{16,}|pk_live_[A-Za-z0-9]{16,}' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "FAIL: key material found in tracked files:" >&2
    echo "$hits" | sed 's/^/  /' >&2
    failed=1
  fi

  [ "$failed" -eq 0 ] && echo "secrets: ok"
  return $failed
}

usage() {
  cat <<'USAGE'
usage: ./verify [target]

  all            every machine-checkable target (default)
  build          compiles, including JTE templates
  storefront     the catalog page lists the seeded stickers
  checkout       buying creates a pending order and redirects to Stripe
  webhook        a signed event flips the order to paid
  confirmation   the confirmation page reads the order by Stripe session id
  confirming     the page tells the truth before the webhook has landed
  signature      only genuinely signed events are processed
  replay         a redelivered event does not get processed twice
  recovery       an order with no session id is still found by its reference
  startup        the app refuses to start without Stripe keys, and says why
  secrets        no key material is tracked by git
  cart           adding, changing and removing items in a cookie-keyed cart
  cart-checkout  a multi-line cart becomes one Stripe session and one order

Targets that cannot run unattended are listed in PRODUCT.md under Stops.
USAGE
}

case "${1:-all}" in
  all)          $MVN test ;;
  build)        $MVN -DskipTests package ;;
  storefront)   $MVN test -Dtest=StorefrontTest ;;
  checkout)     $MVN test -Dtest=CheckoutTest ;;
  webhook)      $MVN test -Dtest=WebhookTest ;;
  confirmation) $MVN test -Dtest=ConfirmationTest ;;
  confirming)   $MVN test -Dtest=ConfirmingTest ;;
  signature)    $MVN test -Dtest=SignatureTest ;;
  replay)       $MVN test -Dtest=ReplayTest ;;
  recovery)     $MVN test -Dtest=RecoveryTest ;;
  startup)      $MVN test -Dtest=StartupTest ;;
  secrets)      check_secrets ;;
  cart)         $MVN test -Dtest=CartTest ;;
  cart-checkout) $MVN test -Dtest=CartCheckoutTest ;;
  -h|--help|help) usage ;;
  *) echo "unknown target: $1" >&2; usage >&2; exit 2 ;;
esac
